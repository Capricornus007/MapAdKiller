<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.ldxm666.mapadkiller"
    android:versionCode="8"
    android:versionName="1.0.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:name=".App"
        android:label="MapAdKiller"
        android:description="@string/description"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
            设置页本体：**故意不带 MAIN/LAUNCHER**，所以它自己不出现在桌面上，
            但保持 exported + enabled —— 隐藏桌面图标后仍可用显式组件名拉起：
                adb shell am start -n io.github.ldxm666.mapadkiller/.MainActivity
            LSPosed 管理器也能照常打开它。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!--
            桌面入口。开/关由 App.setHideIcon() 通过
            PackageManager#setComponentEnabledSetting 切换 —— 这就是「隐藏桌面图标」开关。
        -->
        <activity-alias
            android:name=".DesktopAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="MapAdKiller"
            android:icon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            快捷设置磁贴：隐藏桌面图标之后唯一不会消失的入口。
            它不进启动器，也不依赖 MAIN/LAUNCHER 解析，所以不受上面那个开关影响。
        -->
        <service
            android:name=".SettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="MapAdKiller"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".LearnedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ldxm666.mapadkiller.LEARNED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".LearnedProvider"
            android:authorities="io.github.ldxm666.mapadkiller.learned"
            android:exported="true" />

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.ldxm666.mapadkiller.XposedService"
            android:exported="true" />
    </application>
</manifest>
